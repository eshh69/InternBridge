NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/internbridge?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=internbridge_jwt_secret_dev_key_123456
JWT_EXPIRES_IN=7d

# Supabase Storage Configuration
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_BUCKET=internbridge-uploads
